#!/usr/bin/env php
<?php
declare(strict_types=1);

// Local development recovery only: never prints or commits credentials.
if (PHP_SAPI !== 'cli' || $argc !== 2 || !preg_match('/\A[a-zA-Z0-9_]{3,32}\z/D', $argv[1])) {
    fwrite(STDERR, "Usage: php bin/one-arbnt-password username\n");
    exit(2);
}
$password = getenv('ONE_ARBNT_ADMIN_PASSWORD');
if (!is_string($password) || strlen($password) < 12 || strlen($password) > 256) {
    fwrite(STDERR, "Set ONE_ARBNT_ADMIN_PASSWORD to your new password (12-256 characters).\n");
    exit(2);
}
$path = dirname(__DIR__) . '/arbnt-private';
if (!is_dir($path) || is_link($path) || !is_file($path . '/users.json')
    || is_link($path . '/users.json') || !is_file($path . '/installed.lock')) {
    fwrite(STDERR, "A valid existing private Codespaces community was not found. No changes made.\n");
    exit(1);
}
$lock = fopen($path . '/users.lock', 'c+');
if ($lock === false || !flock($lock, LOCK_EX)) {
    fwrite(STDERR, "Could not lock account records.\n");
    exit(1);
}
try {
    $users = json_decode((string)file_get_contents($path . '/users.json'), true, 512, JSON_THROW_ON_ERROR);
    if (!is_array($users) || !array_is_list($users)) {
        throw new RuntimeException('Invalid user store.');
    }
    $found = 0;
    foreach ($users as &$user) {
        if (!is_array($user) || !isset($user['username'])) {
            throw new RuntimeException('Malformed account entry.');
        }
        if (strcasecmp((string)$user['username'], $argv[1]) === 0) {
            if (($user['role'] ?? '') !== 'admin') {
                throw new RuntimeException('Only existing preview administrator accounts can be reset.');
            }
            $user['password_hash'] = password_hash($password, PASSWORD_DEFAULT);
            $user['session_version'] = ((int)($user['session_version'] ?? 0)) + 1;
            unset($user['reset_hash'], $user['reset_exp']);
            $found++;
        }
    }
    unset($user);
    if ($found !== 1) {
        throw new RuntimeException('Administrator was not found uniquely; no changes made.');
    }
    $json = json_encode($users, JSON_UNESCAPED_UNICODE | JSON_PRETTY_PRINT | JSON_THROW_ON_ERROR);
    $tmp = tempnam($path, '.one-arbnt-');
    if ($tmp === false) {
        throw new RuntimeException('Could not stage updated credentials.');
    }
    try {
        if (file_put_contents($tmp, $json) !== strlen($json) || !chmod($tmp, 0600)
            || !rename($tmp, $path . '/users.json')) {
            throw new RuntimeException('Could not commit updated credentials.');
        }
    } finally {
        if (is_file($tmp)) unlink($tmp);
    }
    fwrite(STDOUT, "Administrator password updated. Previous sessions invalidated.\n");
} catch (Throwable $error) {
    fwrite(STDERR, "Account update failed: " . $error->getMessage() . "\n");
    exit(1);
} finally {
    flock($lock, LOCK_UN);
    fclose($lock);
}
