#!/usr/bin/env php
<?php
declare(strict_types=1);

require dirname(__DIR__) . '/bootstrap.php';

use OneEngine\Modules\Identity\IdentityService;
use OneEngine\Modules\Runtime\Site;
use OneEngine\Storage\JsonStore;
use OneEngine\Security\OriginGuard;

try {
    if (count($argv) !== 4) {
        throw new InvalidArgumentException('Usage: ONE_ADMIN_PASSWORD=... php bin/one-install PRIVATE_DIRECTORY ADMIN_USERNAME HTTPS_ORIGIN');
    }
    $password = getenv('ONE_ADMIN_PASSWORD');
    if (!is_string($password) || $password === '') throw new InvalidArgumentException('Set ONE_ADMIN_PASSWORD temporarily; it is never stored as plain text.');
    $root = dirname(__DIR__);
    $private = $argv[1];
    if (!is_dir($private) && !mkdir($private, 0700, true)) {
        throw new RuntimeException('Cannot create private directory.');
    }
    $resolved = realpath($private);
    if ($resolved === false || !chmod($resolved, 0700)) {
        throw new RuntimeException('Cannot protect private directory.');
    }
    $local = $root . '/config/local.php';
    if (file_exists($local) || is_link($local)) {
        throw new RuntimeException('Local configuration already exists; installation was not changed.');
    }
    $site = Site::fromArray(require $root . '/config/site.php');
    $trustedOrigin = OriginGuard::validate($argv[3]);
    $store = new JsonStore($resolved, $root . '/public');
    (new IdentityService($store))->create($site->id, 'admin-' . bin2hex(random_bytes(8)), $argv[2], $password, 'admin');
    putenv('ONE_ADMIN_PASSWORD');
    $password = '';
    $content = "<?php\ndeclare(strict_types=1);\nreturn " . var_export(['private_dir' => $resolved, 'trusted_origin' => $trustedOrigin, 'storage' => 'json', 'language' => 'ar'], true) . ";\n";
    $temp = $local . '.' . bin2hex(random_bytes(8)) . '.tmp';
    $stream = fopen($temp, 'x+b');
    if ($stream === false) {
        throw new RuntimeException('Cannot create local configuration.');
    }
    try {
        if (!chmod($temp, 0600) || fwrite($stream, $content) !== strlen($content) || !fflush($stream) || !fsync($stream) || !rename($temp, $local)) {
            throw new RuntimeException('Cannot commit local configuration.');
        }
    } finally {
        fclose($stream);
        if (is_file($temp)) {
            unlink($temp);
        }
    }
    echo "ONE Engine CMS installed. Configure the web document root as: {$root}/public\n";
} catch (Throwable $error) {
    fwrite(STDERR, 'Installation failed: ' . $error->getMessage() . "\n");
    exit(1);
}
